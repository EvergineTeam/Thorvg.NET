<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Evergine.Bindings.ThorVG\Evergine.Bindings.ThorVG.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Evergine.Common" Version="2026.5.26.921" />
		<PackageReference Include="Evergine.Mathematics" Version="2026.5.26.921" />
		<PackageReference Include="Evergine.DirectX11" Version="2026.5.26.921" />
		<PackageReference Include="Evergine.Forms" Version="2026.5.26.921" />
	</ItemGroup>

	<ItemGroup>
		<!--
			SVGs, test.jpg, rawimage_200x300.raw: thorvg/thorvg.example res/ (MIT).
			PublicSans-Regular.ttf: US Web Design System, SIL OFL 1.1.
			NotoSansCJK.ttf, NotoSansKR.ttf: Noto subsets, SIL OFL 1.1.
			See Assets/ATTRIBUTION.txt.
		-->
		<Content Include="Assets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
